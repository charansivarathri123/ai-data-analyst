# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage Paths & Database
DATA_STORAGE_PATH=./data
UPLOAD_DIR=./data/raw
EXPORT_DIR=./data/exports
# Relational Database URL (Optional: defaults to local sqlite:///./data/app.db if omitted)
# For Cloud PostgreSQL (Supabase, Neon, Render, Railway, AWS RDS):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# LLM Providers & Observability (Optional for Step 1)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=autonomous-data-analyst

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
