# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage Paths & Database
DATA_STORAGE_PATH=./data
UPLOAD_DIR=./data/raw
EXPORT_DIR=./data/exports
# Relational Database URL (Optional: defaults to local sqlite:///./data/app.db if omitted)
# For Cloud PostgreSQL (Supabase, Neon, Render, Railway, AWS RDS):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Real Email Delivery (Option 1: Free Gmail App Password / SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_gmail_16_character_app_password
# SMTP_FROM_EMAIL=your_email@gmail.com
# Real Email Delivery (Option 2: Resend API)
# RESEND_API_KEY=re_123456789
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Real Mobile SMS Delivery (Option 1: Twilio)
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# Real Mobile SMS Delivery (Option 2: Fast2SMS for Indian numbers)
# FAST2SMS_API_KEY=your_fast2sms_api_key

# Google OAuth (Optional: for real Google One-Tap Sign-In)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
